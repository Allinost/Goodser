.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.error-icon {
  font-size: 64rpx;
  line-height: 1;
}

.error-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gs-color-text, #333333);
}

.error-description {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--gs-color-text-5, #999999);
  word-break: break-all;
}

.error-btn {
  margin-top: 28rpx;
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
  background: var(--gs-color-primary, #1890ff);
  color: var(--gs-color-surface, #ffffff);
  font-size: 26rpx;
}
