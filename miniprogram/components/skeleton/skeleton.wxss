.skeleton {
  padding: 0 24rpx;
}

.skeleton-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: var(--gs-color-surface, #ffffff);
}

.skeleton-line {
  height: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--gs-color-divider, #f0f0f0) 25%, #e6e6e6 37%, var(--gs-color-divider, #f0f0f0) 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
}

.skeleton-line:last-child {
  margin-bottom: 0;
}

.skeleton-line--lg {
  width: 62%;
  height: 32rpx;
}

.skeleton-line--md {
  width: 82%;
}

.skeleton-line--sm {
  width: 44%;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
