.order-card {
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-info-left {
  display: flex;
  flex-direction: column;
}

.order-no {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gs-color-text, #333333);
}

.order-no-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.order-type-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  font-weight: 500;
}

.order-type-tag-blue {
  background: var(--gs-color-primary-bg, #e6f7ff);
  color: var(--gs-color-primary, #1890ff);
}

.order-type-tag-orange {
  background: var(--gs-color-warning-bg, #fff7e6);
  color: var(--gs-color-warning, #fa8c16);
}

.order-time {
  font-size: 24rpx;
  color: var(--gs-color-text-5, #999999);
  margin-top: 6rpx;
}

.order-items {
  margin-bottom: 12rpx;
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.item-name {
  font-size: 26rpx;
  color: var(--gs-color-text-2, #666666);
}

.item-qty {
  font-size: 26rpx;
  color: var(--gs-color-text, #333333);
  font-weight: 500;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-total {
  font-size: 24rpx;
  color: var(--gs-color-text-5, #999999);
}

.order-arrow {
  font-size: 26rpx;
  color: var(--gs-color-primary, #1890ff);
}
