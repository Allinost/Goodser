.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--gs-color-surface, #ffffff);
  gap: 16rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--gs-color-bg, #f5f5f5);
  border-radius: 36rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  height: 72rpx;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: var(--gs-color-text, #333333);
}

.search-clear {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.4;
}

.search-btn {
  padding: 0 24rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gs-color-primary, #1890ff);
  color: var(--gs-color-surface, #ffffff);
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
}
