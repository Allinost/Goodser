.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}

.empty-icon-text {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: var(--gs-color-text, #333333);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--gs-color-text-5, #999999);
  text-align: center;
  line-height: 1.6;
}

.empty-action {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  background: var(--gs-color-primary, #1890ff);
  border-radius: 36rpx;
}

.empty-action-text {
  color: var(--gs-color-surface, #ffffff);
  font-size: 28rpx;
  font-weight: 500;
}
