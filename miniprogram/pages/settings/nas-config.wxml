<view class="page-nas-config">
  <!-- 连接状态 -->
  <view class="status-card card">
    <view class="status-indicator">
      <view class="status-dot {{connected ? 'status-connected' : 'status-disconnected'}}"></view>
      <text class="status-text">{{connected ? '后端已连接' : '后端未连接'}}</text>
    </view>
    <text class="status-desc" wx:if="{{!connected}}">请配置 Go 后端服务连接信息</text>
    <text class="status-desc" wx:else>后端服务已就绪，可进行数据同步</text>
  </view>

  <!-- 连接配置 -->
  <view class="card">
    <view class="form-group">
      <text class="form-label">后端地址</text>
      <input class="form-input" placeholder="如: 192.168.1.36" value="{{backendAddress}}" bindinput="onAddressInput" />
    </view>
    <view class="form-group">
      <text class="form-label">端口</text>
      <input class="form-input" type="number" placeholder="29092" value="{{backendPort}}" bindinput="onPortInput" />
    </view>
    <view class="form-group">
      <text class="form-label">用户名</text>
      <input class="form-input" placeholder="登录用户名" value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view class="form-group">
      <text class="form-label">密码</text>
      <input class="form-input" placeholder="登录密码" password="{{true}}" value="{{password}}" bindinput="onPasswordInput" />
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <view class="btn btn-ghost" bindtap="onTestConnection" disabled="{{connecting}}">{{connecting ? '验证中...' : '测试连接'}}</view>
    <view class="btn btn-primary" bindtap="onSave" disabled="{{connecting}}">保存并连接</view>
  </view>
</view>
