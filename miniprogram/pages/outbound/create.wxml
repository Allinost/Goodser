<view class="page-create-outbound">
  <!-- 步骤指引 -->
  <view class="steps">
    <view class="step step--done">
      <text class="step-index">1</text>
      <text class="step-label">目录信息</text>
    </view>
    <view class="step-line {{selectedItems.length || selectedCombo ? 'step-line--done' : ''}}"></view>
    <view class="step {{selectedItems.length || selectedCombo ? 'step--done' : 'step--current'}}">
      <text class="step-index">2</text>
      <text class="step-label">选择商品</text>
    </view>
    <view class="step-line"></view>
    <view class="step step--todo">
      <text class="step-index">3</text>
      <text class="step-label">确认提交</text>
    </view>
  </view>

  <!-- 选择库存目录 -->
  <view class="card">
    <view class="form-group">
      <text class="form-label">出库目录 <text class="required">*</text></text>
      <picker range="{{inventoryNames}}" value="{{inventoryIndex}}" bindchange="onInventoryChange">
        <view class="form-picker">
          <text>{{inventoryNames[inventoryIndex] || '请选择'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="card">
    <view class="form-group">
      <text class="form-label">订单信息</text>
      <input class="form-input" placeholder="请输入订单信息" value="{{orderInfo}}" bindinput="onOrderInfoInput" />
    </view>
    <view class="form-group">
      <text class="form-label">订单备注</text>
      <textarea class="form-textarea" placeholder="请输入备注" value="{{orderRemark}}" bindinput="onRemarkInput" maxlength="200" />
    </view>
  </view>

  <!-- 组合包下单 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">组合包</text>
      <text class="link-text" wx:if="{{selectedComboId}}" bindtap="onClearCombo">改为按商品出库</text>
    </view>
    <view class="form-group">
      <text class="form-label">选择组合包（可选）</text>
      <picker range="{{comboOptions}}" range-key="label" value="{{comboIndex}}" bindchange="onComboChange" disabled="{{combos.length === 0}}">
        <view class="form-picker">
          <text>{{selectedCombo ? selectedCombo.name : (combos.length ? '不使用组合包' : '当前目录暂无组合包')}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <block wx:if="{{selectedCombo}}">
      <view class="form-group">
        <text class="form-label">组合包数量</text>
        <input class="form-input" type="number" value="{{comboQuantity}}" bindinput="onComboQuantityInput" />
      </view>
      <view class="combo-summary">
        <view class="combo-meta">
          <text>可售 {{selectedCombo.availability}}</text>
          <text wx:if="{{selectedCombo.price > 0}}">组合价 ¥{{selectedCombo.price}}</text>
        </view>
        <view class="combo-parts">
          <text class="combo-part" wx:for="{{selectedCombo.items}}" wx:for-item="part" wx:key="product_id">
            {{part.product_name}} × {{part.quantity}}
          </text>
        </view>
        <text class="combo-tip">提交后将按组件自动展开并锁定库存。</text>
      </view>
    </block>
  </view>

  <!-- 搜索添加商品 -->
  <view class="card" wx:if="{{!selectedCombo}}">
    <view class="section-header">
      <text class="section-title">出库商品</text>
    </view>
    <search-bar
      placeholder="搜索商品名称..."
      bind:search="onProductSearch"
      bind:clear="onClearProductSearch"
    />

    <!-- 搜索结果 -->
    <view class="search-results" wx:if="{{searchResults.length > 0 && showSearchResults}}">
      <view class="multi-select-bar">
        <text class="multi-select-toggle" bindtap="onToggleMultiSelect">
          {{multiSelectMode ? '取消多选' : '多选'}}
        </text>
        <view class="multi-select-confirm-btn" wx:if="{{multiSelectMode && checkedProductIds.length > 0}}" bindtap="onConfirmMultiSelect">
          确认添加 ({{checkedProductIds.length}})
        </view>
      </view>
      <view class="search-result-item {{multiSelectMode && checkedProductIds.indexOf(item._id) > -1 ? 'search-result-item-checked' : ''}}" wx:for="{{searchResults}}" wx:key="_id" bindtap="onAddProduct" data-product="{{item}}">
        <view class="multi-checkbox" wx:if="{{multiSelectMode}}">
          <view class="checkbox-inner {{checkedProductIds.indexOf(item._id) > -1 ? 'checkbox-checked' : ''}}"></view>
        </view>
        <image class="result-image" src="{{item.image_url || '/images/placeholder.png'}}" mode="aspectFill" />
        <view class="result-info">
          <text class="result-name">{{item.name}}</text>
          <text class="result-code">{{item.code}}</text>
          <text class="result-stock">可用: {{item.quantity}}{{item.reserved_quantity > 0 ? ' · 锁定 ' + item.reserved_quantity : ''}}</text>
        </view>
        <text class="result-add" wx:if="{{!multiSelectMode}}">+ 添加</text>
      </view>
    </view>

    <!-- 已选商品列表 -->
    <view class="selected-list" wx:if="{{selectedItems.length > 0}}">
      <view class="divider"></view>
      <view class="selected-item" wx:for="{{selectedItems}}" wx:key="product_id">
        <image class="selected-image" src="{{item.image_url || '/images/placeholder.png'}}" mode="aspectFill" />
        <view class="selected-info">
          <text class="selected-name">{{item.product_name}}</text>
          <text class="selected-stock">库存: {{item.stock}}</text>
        </view>
        <view class="qty-control">
          <text class="qty-btn" bindtap="onDecreaseQty" data-index="{{index}}">-</text>
          <text class="qty-value">{{item.quantity}}</text>
          <text class="qty-btn" bindtap="onIncreaseQty" data-index="{{index}}">+</text>
        </view>
        <text class="remove-btn" bindtap="onRemoveItem" data-index="{{index}}">✕</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar bottom-bar--split">
    <view class="bottom-summary">
      <text class="bottom-count">
        {{selectedCombo ? '组合包 × ' + comboQuantity : selectedItems.length + ' 种 · ' + totalQuantity + ' 件'}}
      </text>
      <text class="bottom-hint">确认后立即扣减可用库存</text>
    </view>
    <view class="btn btn-primary btn-submit {{submitting ? 'btn-disabled' : ''}}" bindtap="{{submitting ? '' : 'onSubmit'}}">{{submitting ? '创建中...' : '新建出库单'}}</view>
  </view>
</view>
