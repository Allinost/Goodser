<view class="page-outbound-detail">
  <!-- 订单头部 -->
  <view class="card order-header-card">
    <view class="order-header-row">
      <text class="order-no">{{order.order_no}}</text>
      <text class="tag {{statusTagClass}}">{{statusLabel}}</text>
    </view>
    <view class="order-meta">
      <text class="order-type-tag {{order.type === 'reserve' ? 'order-type-tag-orange' : 'order-type-tag-blue'}}">{{order.type === 'outbound' ? '出库单' : '预留单'}}</text>
      <text class="meta-item">{{order._createdAt}}</text>
    </view>
    <view class="info-row" wx:if="{{order.order_info}}">
      <text class="label">订单信息</text>
      <text class="value">{{order.order_info}}</text>
    </view>
    <view class="info-row" wx:if="{{order.remark}}">
      <text class="label">备注</text>
      <text class="value">{{order.remark}}</text>
    </view>
    <view class="info-row" wx:if="{{order._createdAt}}">
      <text class="label">创建时间</text>
      <text class="value">{{order._createdAt}}</text>
    </view>
    <view class="info-row" wx:if="{{order._convertedAt}}">
      <text class="label">转出库时间</text>
      <text class="value">{{order._convertedAt}}</text>
    </view>
    <view class="info-row" wx:if="{{order._confirmedAt}}">
      <text class="label">确认时间</text>
      <text class="value">{{order._confirmedAt}}</text>
    </view>
    <view class="info-row" wx:if="{{order._cancelledAt}}">
      <text class="label">取消时间</text>
      <text class="value">{{order._cancelledAt}}</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="card">
    <view class="section-title">出库商品</view>
    <view class="item-list">
      <view class="outbound-item" wx:for="{{order.items}}" wx:key="product_id" bindtap="onProductTap" data-id="{{item.product_id}}">
        <image class="item-image" src="{{item.image_url || '/images/placeholder.png'}}" mode="aspectFill" />
        <view class="item-info">
          <text class="item-name">{{item.product_name}}</text>
          <text class="item-code">{{item.product_code}}</text>
        </view>
        <view class="item-qty">× {{item.quantity}}</view>
      </view>
    </view>
    <view class="divider"></view>
    <view class="order-summary">
      共 {{order.items.length}} 种商品，合计 {{totalQuantity}} 件
    </view>
  </view>

  <!-- 退货记录 -->
  <view class="card">
    <view class="section-head-row">
      <text class="section-title">退货记录</text>
      <text class="section-count">{{returns.length}} 张</text>
    </view>
    <view class="loading-hint" wx:if="{{loadingReturns}}">加载中...</view>
    <view class="empty-hint" wx:elif="{{!returns.length}}">暂无退货记录</view>
    <view class="return-row" wx:for="{{returns}}" wx:key="_id">
      <view class="return-row-head">
        <view>
          <text class="tag {{item._statusClass}}">{{item._statusLabel}}</text>
          <text class="return-reason">{{item._reasonLabel}}</text>
        </view>
        <text class="return-date">{{item._createdAt}}</text>
      </view>
      <view class="return-line" wx:for="{{item.items}}" wx:for-item="line" wx:key="product_id">
        <text class="return-line-name">{{line.product_name || line.product_code}}</text>
        <text class="return-line-qty">× {{line.quantity}}</text>
        <text class="tag {{line.restock ? 'tag-green' : 'tag-gray'}}">{{line.restock ? '回库' : '不回库'}}</text>
      </view>
      <view class="return-actions" wx:if="{{item.status === 'pending'}}">
        <view class="mini-btn mini-btn-ghost" bindtap="onCancelReturn" data-ret="{{item}}">取消</view>
        <view class="mini-btn mini-btn-primary" bindtap="onConfirmReturn" data-ret="{{item}}">确认退货</view>
      </view>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="bottom-bar" wx:if="{{order.status === 'pending' || order.status === 'reserved'}}">
    <view class="btn btn-ghost" bindtap="onCancel">
      {{order.type === 'outbound' ? '取消出库' : '取消预留'}}
    </view>
    <view class="btn btn-primary" bindtap="onConfirm">
      {{order.type === 'outbound' ? '确认出库' : '转出库'}}
    </view>
  </view>
  <view class="bottom-bar" wx:elif="{{canReturn}}">
    <view class="btn btn-primary" bindtap="onCreateReturn">申请退货</view>
  </view>
</view>
