.page-create-outbound {
  min-height: 100vh;
  background: var(--gs-color-bg, #f5f5f5);
  padding-bottom: 140rpx;
}

.card {
  margin: 20rpx 24rpx;
}

/* 步骤指引 */
.steps {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 32rpx;
  background: var(--gs-color-surface, #ffffff);
}

.step {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.step-index {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 20rpx;
  color: var(--gs-color-text-5, #999999);
  background: var(--gs-color-divider, #f0f0f0);
}

.step-label {
  font-size: 22rpx;
  color: var(--gs-color-text-5, #999999);
}

.step--done .step-index {
  background: var(--gs-color-primary, #1890ff);
  color: var(--gs-color-surface, #ffffff);
}

.step--done .step-label {
  color: var(--gs-color-primary, #1890ff);
  font-weight: 500;
}

.step--current .step-index {
  background: var(--gs-color-primary-bg, #e6f7ff);
  color: var(--gs-color-primary, #1890ff);
  border: 2rpx solid var(--gs-color-primary, #1890ff);
}

.step--current .step-label {
  color: var(--gs-color-text, #333333);
  font-weight: 500;
}

.step-line {
  flex: 1;
  height: 2rpx;
  min-width: 16rpx;
  background: var(--gs-color-divider, #f0f0f0);
}

.step-line--done {
  background: var(--gs-color-primary, #1890ff);
}

/* 吸底提交区 */
.bottom-bar--split {
  align-items: center;
  gap: 20rpx;
}

.bottom-summary {
  flex: 1;
  min-width: 0;
}

.bottom-count {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gs-color-text, #333333);
}

.bottom-hint {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--gs-color-text-5, #999999);
}

.bottom-bar--split .btn-submit {
  flex: 0 0 auto;
  padding: 0 40rpx;
  height: 76rpx;
  margin: 0;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gs-color-text, #333333);
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid var(--gs-color-border-2, #d9d9d9);
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  border: 2rpx solid var(--gs-color-border-2, #d9d9d9);
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gs-color-text, #333333);
}

/* 搜索结果 */
.search-results {
  max-height: 480rpx;
  overflow-y: auto;
  border: 2rpx solid var(--gs-color-divider, #f0f0f0);
  border-radius: 8rpx;
}

.search-result-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 2rpx solid var(--gs-color-bg, #f5f5f5);
}

.search-result-item:active {
  background: var(--gs-color-bg-4, #f9f9f9);
}

.result-image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  background: var(--gs-color-divider, #f0f0f0);
  flex-shrink: 0;
}

.result-info {
  flex: 1;
  margin-left: 16rpx;
}

.result-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gs-color-text, #333333);
  display: block;
}

.result-code {
  font-size: 22rpx;
  color: var(--gs-color-text-5, #999999);
  display: block;
}

.result-stock {
  font-size: 22rpx;
  color: var(--gs-color-primary, #1890ff);
  display: block;
}

.result-add {
  font-size: 26rpx;
  color: var(--gs-color-primary, #1890ff);
  font-weight: 500;
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  background: var(--gs-color-primary-bg, #e6f7ff);
  border-radius: 6rpx;
}

/* 已选商品 */
.selected-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--gs-color-bg, #f5f5f5);
}

.selected-image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  background: var(--gs-color-divider, #f0f0f0);
  flex-shrink: 0;
}

.selected-info {
  flex: 1;
  margin-left: 16rpx;
}

.selected-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gs-color-text, #333333);
  display: block;
  margin-bottom: 4rpx;
}

.selected-stock {
  font-size: 22rpx;
  color: var(--gs-color-text-5, #999999);
}

.qty-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 16rpx;
}

.qty-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gs-color-bg, #f5f5f5);
  border-radius: 8rpx;
  font-size: 32rpx;
  color: var(--gs-color-text, #333333);
  font-weight: 600;
}

.qty-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gs-color-primary, #1890ff);
  min-width: 48rpx;
  text-align: center;
}

.remove-btn {
  font-size: 28rpx;
  color: var(--gs-color-danger, #ff4d4f);
  padding: 8rpx;
}

/* 多选 */
.multi-select-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 20rpx;
  border-bottom: 2rpx solid var(--gs-color-divider, #f0f0f0);
  background: var(--gs-color-bg-3, #fafafa);
}

.multi-select-toggle {
  font-size: 26rpx;
  color: var(--gs-color-primary, #1890ff);
  font-weight: 500;
}

.multi-select-confirm-btn {
  font-size: 26rpx;
  color: var(--gs-color-surface, #ffffff);
  background: var(--gs-color-primary, #1890ff);
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.search-result-item-checked {
  background: var(--gs-color-primary-bg-2, #f0f7ff);
}

.multi-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--gs-color-border-2, #d9d9d9);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.checkbox-inner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
}

.checkbox-checked {
  background: var(--gs-color-primary, #1890ff);
}

/* 选择器 */
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--gs-color-border-2, #d9d9d9);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--gs-color-text, #333333);
  box-sizing: border-box;
}

.picker-arrow {
  color: var(--gs-color-text-5, #999999);
  font-size: 20rpx;
  margin-left: 12rpx;
}

.link-text {
  font-size: 24rpx;
  color: var(--gs-color-primary, #1890ff);
}

/* 组合包 */
.combo-summary {
  background: var(--gs-color-primary-bg-2, #f0f7ff);
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
}

.combo-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  font-size: 24rpx;
  color: var(--gs-color-primary, #1890ff);
}

.combo-parts {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.combo-part {
  background: var(--gs-color-surface, #ffffff);
  color: var(--gs-color-text, #333333);
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
}

.combo-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--gs-color-text-4, #8c8c8c);
}
