<view class="page-bundle-edit">
  <view class="card">
    <view class="form-row">
      <view class="form-group flex-1">
        <text class="form-label">名称 <text class="required">*</text></text>
        <input class="form-input" placeholder="捆名称" value="{{name}}" bindinput="onNameInput" />
      </view>
      <view class="form-group flex-1">
        <text class="form-label">编码</text>
        <input class="form-input" placeholder="留空自动生成" value="{{code}}" bindinput="onCodeInput" />
      </view>
    </view>
    <view class="form-group">
      <text class="form-label">描述</text>
      <textarea class="form-textarea" placeholder="选填" value="{{description}}" bindinput="onDescriptionInput" maxlength="200" />
    </view>
    <view class="form-row">
      <view class="form-group flex-1">
        <text class="form-label">状态</text>
        <picker range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange">
          <view class="form-picker">
            <text>{{statusOptions[statusIndex].label}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
      <view class="form-group flex-1">
        <text class="form-label">价格模式</text>
        <picker range="{{priceModeOptions}}" range-key="label" value="{{priceModeIndex}}" bindchange="onPriceModeChange">
          <view class="form-picker">
            <text>{{priceModeOptions[priceModeIndex].label}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
    </view>
    <view class="form-group" wx:if="{{priceMode === 'fixed'}}">
      <text class="form-label">固定价格 / 单捆</text>
      <input class="form-input" type="digit" placeholder="0.00" value="{{fixedPrice}}" bindinput="onFixedPriceInput" />
    </view>
  </view>

  <view class="card">
    <view class="section-title">规则（均按单捆计算）</view>
    <view class="form-row">
      <view class="form-group flex-1">
        <text class="form-label">主商品最少数量</text>
        <input class="form-input" type="number" value="{{minMainQuantity}}" bindinput="onMinMainQuantityInput" />
      </view>
      <view class="form-group flex-1">
        <text class="form-label">主商品最低金额</text>
        <input class="form-input" type="digit" placeholder="0" value="{{minMainAmount}}" bindinput="onMinMainAmountInput" />
      </view>
    </view>
    <view class="form-row">
      <view class="form-group flex-1">
        <text class="form-label">副区最少数量</text>
        <input class="form-input" type="number" placeholder="0" value="{{minSubQuantity}}" bindinput="onMinSubQuantityInput" />
      </view>
      <view class="form-group flex-1">
        <text class="form-label">副区最多数量（0 不限）</text>
        <input class="form-input" type="number" placeholder="0" value="{{maxSubQuantity}}" bindinput="onMaxSubQuantityInput" />
      </view>
      <view class="form-group flex-1">
        <text class="form-label">副区最低金额</text>
        <input class="form-input" type="digit" placeholder="0" value="{{minSubAmount}}" bindinput="onMinSubAmountInput" />
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">主商品条件</view>
    <view class="form-row">
      <view class="form-group flex-1">
        <text class="form-label">系列</text>
        <picker range="{{seriesOptions}}" range-key="name" value="{{seriesIndex}}" bindchange="onSeriesChange">
          <view class="form-picker">
            <text>{{seriesOptions[seriesIndex].name}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
      <view class="form-group flex-1">
        <text class="form-label">套型</text>
        <picker range="{{setTypeOptions}}" range-key="name" value="{{setTypeIndex}}" bindchange="onSetTypeChange">
          <view class="form-picker">
            <text>{{setTypeOptions[setTypeIndex].name}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
    </view>
    <view class="form-row">
      <view class="form-group flex-1">
        <text class="form-label">商品类型</text>
        <picker range="{{productTypeOptions}}" range-key="name" value="{{productTypeIndex}}" bindchange="onProductTypeChange">
          <view class="form-picker">
            <text>{{productTypeOptions[productTypeIndex].name}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
      <view class="form-group flex-1">
        <text class="form-label">角色</text>
        <picker range="{{characterOptions}}" range-key="name" value="{{characterIndex}}" bindchange="onCharacterChange">
          <view class="form-picker">
            <text>{{characterOptions[characterIndex].name}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
    </view>
    <view class="form-row">
      <view class="form-group flex-1">
        <text class="form-label">状态编码</text>
        <picker range="{{statusCodeOptions}}" range-key="name" value="{{statusCodeIndex}}" bindchange="onStatusCodeChange">
          <view class="form-picker">
            <text>{{statusCodeOptions[statusCodeIndex].name}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
      <view class="form-group flex-1">
        <text class="form-label">关键词</text>
        <input class="form-input" placeholder="名称或编码" value="{{filter.keyword}}" bindinput="onFilterKeywordInput" />
      </view>
    </view>
    <view class="hint">显式清单与筛选条件同时存在时按 AND 校验；至少需要配置一种。</view>

    <view class="sub-section-title">显式主商品（可选）</view>
    <view class="search-row">
      <input class="form-input search-input" placeholder="搜索并添加主商品" value="{{mainKeyword}}" bindinput="onMainKeywordInput" />
    </view>
    <view class="search-results" wx:if="{{mainResults.length > 0}}">
      <view class="search-result-item" wx:for="{{mainResults}}" wx:key="_id" data-product="{{item}}" bindtap="onAddMainProduct">
        <view class="result-info">
          <text class="result-name">{{item.name}}</text>
          <text class="result-code">{{item.code}}</text>
        </view>
        <text class="result-add">+ 添加</text>
      </view>
    </view>
    <view class="selected-list" wx:if="{{mainProducts.length > 0}}">
      <view class="selected-item" wx:for="{{mainProducts}}" wx:key="product_id">
        <text class="selected-name">{{item.product_name}}（{{item.product_code}}）</text>
        <text class="remove-btn" data-index="{{index}}" bindtap="onRemoveMainProduct">✕</text>
      </view>
    </view>
    <view class="empty-tip" wx:else>未选择显式主商品</view>
  </view>

  <view class="card">
    <view class="section-title">副区商品（必须，店主选定）</view>
    <view class="search-row">
      <input class="form-input search-input" placeholder="搜索并添加副区商品" value="{{subKeyword}}" bindinput="onSubKeywordInput" />
    </view>
    <view class="search-results" wx:if="{{subResults.length > 0}}">
      <view class="search-result-item" wx:for="{{subResults}}" wx:key="_id" data-product="{{item}}" bindtap="onAddSubProduct">
        <view class="result-info">
          <text class="result-name">{{item.name}}</text>
          <text class="result-code">{{item.code}} · 可用 {{item.quantity}}</text>
        </view>
        <text class="result-add">+ 添加</text>
      </view>
    </view>
    <view class="selected-list" wx:if="{{subProducts.length > 0}}">
      <view class="selected-item" wx:for="{{subProducts}}" wx:key="product_id">
        <view class="selected-info">
          <text class="selected-name">{{item.product_name}}</text>
          <text class="selected-code">{{item.product_code}} · 可用 {{item.available}}</text>
        </view>
        <view class="qty-box">
          <text class="qty-label">单捆</text>
          <input class="qty-input" type="number" value="{{item.default_quantity}}" data-index="{{index}}" bindinput="onSubQtyInput" />
        </view>
        <text class="remove-btn" data-index="{{index}}" bindtap="onRemoveSubProduct">✕</text>
      </view>
    </view>
    <view class="empty-tip" wx:else>还没有副区商品</view>
  </view>

  <view class="bottom-bar">
    <view class="btn btn-primary btn-block {{submitting ? 'btn-disabled' : ''}}" bindtap="{{submitting ? '' : 'onSave'}}">{{submitting ? '保存中...' : '保存'}}</view>
  </view>
</view>
