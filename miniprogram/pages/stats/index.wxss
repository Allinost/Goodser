.page-stats {
  min-height: 100vh;
  background: var(--gs-color-bg, #f5f5f5);
  padding-bottom: 40rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--gs-color-surface, #ffffff);
}

.inventory-selector {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gs-color-text, #333333);
}

.selector-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--gs-color-text-5, #999999);
}

.day-selector {
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  background: var(--gs-color-primary-bg-4, #f0f5ff);
  color: var(--gs-color-primary, #1890ff);
  font-size: 24rpx;
}

.loading {
  padding: 80rpx;
  text-align: center;
  color: var(--gs-color-text-5, #999999);
  font-size: 26rpx;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 14rpx;
}

.stat-card {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  padding: 22rpx;
  box-sizing: border-box;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: var(--gs-color-text-3, #888888);
}

.stat-value {
  display: block;
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--gs-color-text, #333333);
}

.stat-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--gs-color-text-6, #aaaaaa);
}

.card {
  margin: 10rpx 24rpx 20rpx;
}

.kv {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--gs-color-text-2, #666666);
  border-bottom: 2rpx dashed var(--gs-color-divider, #f0f0f0);
}

.kv:last-child {
  border-bottom: none;
}

.kv-value {
  font-weight: 600;
  color: var(--gs-color-text, #333333);
}

.legend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: var(--gs-color-text-3, #888888);
}

.trend-hint {
  margin-left: auto;
  color: var(--gs-color-primary, #1890ff);
}

.dot {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  margin-right: 6rpx;
  border-radius: 4rpx;
}

.dot-out {
  background: var(--gs-color-primary, #1890ff);
}

.dot-ret {
  background: var(--gs-color-success, #52c41a);
}

.trend-scroll {
  width: 100%;
}

.trend {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  min-height: 200rpx;
  padding-top: 10rpx;
}

.trend-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 34rpx;
  padding: 6rpx 4rpx;
  border-radius: 8rpx;
}

.trend-col--selected {
  background: var(--gs-color-primary-bg-2, #f0f7ff);
}

.trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 130rpx;
}

.bar {
  width: 12rpx;
  min-height: 2rpx;
  border-radius: 3rpx 3rpx 0 0;
}

.bar-out {
  background: var(--gs-color-primary, #1890ff);
}

.bar-ret {
  background: var(--gs-color-success, #52c41a);
}

.trend-label {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: var(--gs-color-text-6, #aaaaaa);
  white-space: nowrap;
}

.trend-col--selected .trend-label {
  color: var(--gs-color-primary, #1890ff);
  font-weight: 600;
}

.trend-detail {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: var(--gs-color-primary-bg-2, #f0f7ff);
}

.trend-detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.trend-detail-date {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gs-color-text, #333333);
}

.trend-detail-total {
  font-size: 22rpx;
  color: var(--gs-color-text-2, #666666);
}

.trend-detail-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: 24rpx;
  color: var(--gs-color-text-2, #666666);
}

.trend-detail-out {
  color: var(--gs-color-primary, #1890ff);
  font-weight: 600;
}

.trend-detail-ret {
  color: var(--gs-color-success, #52c41a);
  font-weight: 600;
}

.rank {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--gs-color-bg, #f5f5f5);
}

.rank:last-child {
  border-bottom: none;
}

.rank-index {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--gs-color-primary-bg-4, #f0f5ff);
  color: var(--gs-color-primary, #1890ff);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name {
  display: block;
  font-size: 26rpx;
  color: var(--gs-color-text, #333333);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-code {
  display: block;
  font-size: 20rpx;
  color: var(--gs-color-text-6, #aaaaaa);
}

.rank-qty {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gs-color-primary, #1890ff);
}

.series-row {
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--gs-color-bg, #f5f5f5);
}

.series-row:last-child {
  border-bottom: none;
}

.series-head,
.series-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--gs-color-text-2, #666666);
}

.series-meta {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--gs-color-text-6, #aaaaaa);
}

.series-bar {
  height: 10rpx;
  margin-top: 8rpx;
  border-radius: 5rpx;
  background: var(--gs-color-divider, #f0f0f0);
  overflow: hidden;
}

.series-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, var(--gs-color-primary, #1890ff), var(--gs-color-primary-light, #69b1ff));
}
