.page-returns {
  min-height: 100vh;
  background: var(--gs-color-bg, #f5f5f5);
  padding-bottom: 40rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--gs-color-surface, #ffffff);
}

.inventory-selector {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gs-color-text, #333333);
}

.selector-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--gs-color-text-5, #999999);
}

.top-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn-sm {
  padding: 10rpx 22rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.action-btn-primary {
  background: var(--gs-color-primary, #1890ff);
  color: var(--gs-color-surface, #ffffff);
}

.action-btn-danger {
  background: var(--gs-color-danger-bg, #fff1f0);
  color: var(--gs-color-danger, #ff4d4f);
}

.action-btn-ghost {
  background: var(--gs-color-bg, #f5f5f5);
  color: var(--gs-color-text-2, #666666);
}

.tab-bar {
  display: flex;
  padding: 4rpx 24rpx 0;
  background: var(--gs-color-surface, #ffffff);
  border-bottom: 2rpx solid var(--gs-color-divider, #f0f0f0);
}

.tab-item {
  padding: 18rpx 26rpx;
  font-size: 26rpx;
  color: var(--gs-color-text-2, #666666);
}

.tab-active {
  color: var(--gs-color-primary, #1890ff);
  font-weight: 600;
  border-bottom: 4rpx solid var(--gs-color-primary, #1890ff);
}

.stats-bar {
  padding: 16rpx 24rpx;
}

.stats-text {
  font-size: 24rpx;
  color: var(--gs-color-text-5, #999999);
}

.loading {
  padding: 60rpx;
  text-align: center;
  color: var(--gs-color-text-5, #999999);
  font-size: 26rpx;
}

.return-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
}

.return-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.return-order-no {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gs-color-text, #333333);
}

.return-date {
  font-size: 22rpx;
  color: var(--gs-color-text-5, #999999);
}

.return-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--gs-color-text-2, #666666);
}

.return-reason {
  color: var(--gs-color-primary, #1890ff);
}

.return-items {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--gs-color-bg, #f5f5f5);
}

.return-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: var(--gs-color-text, #333333);
}

.return-item-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.return-item-qty {
  color: var(--gs-color-primary, #1890ff);
  font-weight: 600;
}

.return-remark {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--gs-color-text-3, #888888);
}

.return-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--gs-color-bg, #f5f5f5);
}

.return-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: var(--gs-radius-sm);
  background: var(--gs-color-bg-2, #f5f7fa);
  font-size: 24rpx;
  color: var(--gs-color-text-2, #666666);
}

.summary-toggle {
  color: var(--gs-color-primary, #1890ff);
}

.load-more {
  padding: 24rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--gs-color-primary, #1890ff);
}

.empty-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--gs-color-text-7, #bbbbbb);
}
