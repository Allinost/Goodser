.page-return-create {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 24rpx 180rpx;
  box-sizing: border-box;
}

.loading {
  padding: 80rpx;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
}

.order-card {
  padding: 24rpx;
}

.order-no {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.order-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888888;
}

.card {
  margin-bottom: 20rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.select-actions {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
  color: #1890ff;
}

.return-item {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.return-item:last-child {
  border-bottom: none;
}

.item-check {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #cccccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.item-check-active {
  background: #1890ff;
  border-color: #1890ff;
}

.item-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 220rpx;
}

.item-name {
  display: block;
  font-size: 27rpx;
  color: #333333;
}

.item-code {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #999999;
}

.item-remain {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #fa8c16;
}

.qty-control {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  background: #f0f5ff;
  color: #1890ff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qty-value {
  min-width: 46rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.restock-control {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-left: auto;
}

.restock-label {
  font-size: 22rpx;
  color: #888888;
}

.restock-control switch {
  transform: scale(0.7);
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 76rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333333;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999999;
}

.reason-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999999;
}

.remark-input {
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #333333;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.bottom-bar .btn {
  flex: 1;
}
